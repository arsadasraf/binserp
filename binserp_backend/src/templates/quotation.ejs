<!DOCTYPE html>
<html>
<head>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    </style>
</head>
<body class="bg-white p-8">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="flex justify-between items-start mb-8">
            <div>
                <% if (companyInfo?.logo) { %>
                    <img src="<%= companyInfo.logo %>" class="h-16 mb-4" />
                <% } %>
                <h1 class="text-xl font-bold text-slate-800"><%= companyInfo?.companyName || 'Company Name' %></h1>
                <p class="text-sm text-slate-500 mt-1 max-w-xs"><%= companyInfo?.billingAddress || '' %></p>
                <% if (companyInfo?.contactNumber) { %><p class="text-sm text-slate-500">Phone: <%= companyInfo.contactNumber %></p><% } %>
                <% if (companyInfo?.email) { %><p class="text-sm text-slate-500">Email: <%= companyInfo.email %></p><% } %>
            </div>
            <div class="text-right">
                <h2 class="text-3xl font-bold text-indigo-600 mb-2">QUOTATION</h2>
                <p class="text-sm text-slate-600"><span class="font-semibold">Quotation No:</span> <%= doc.quotationNumber %></p>
                <p class="text-sm text-slate-600"><span class="font-semibold">Date:</span> <%= new Date(doc.date).toLocaleDateString() %></p>
            </div>
        </div>

        <!-- Bill To -->
        <div class="mb-8 p-4 bg-slate-50 rounded-lg border border-slate-100">
            <h3 class="text-sm font-bold text-slate-800 mb-2">BILL TO:</h3>
            <p class="text-sm font-semibold text-slate-700"><%= doc.customerName || 'N/A' %></p>
            <p class="text-sm text-slate-500 mt-1"><%= doc.customerAddress || '' %></p>
        </div>

        <% 
            const getCurrSym = (curr) => {
                switch ((curr || '').toUpperCase()) {
                    case 'USD': return '$';
                    case 'POUND': case 'GBP': return '£';
                    case 'EURO': case 'EUR': return '€';
                    case 'YEN': case 'JPY': return '¥';
                    case 'YUAN': case 'CNY': case 'RMB': return '¥';
                    case 'INR': default: return '₹';
                }
            };
            const currSym = getCurrSym(doc.currency);
        %>
        <!-- Items Table -->
        <table class="w-full text-sm text-left mb-8">
            <thead class="text-xs text-white uppercase bg-indigo-600 rounded-t-lg">
                <tr>
                    <th class="px-3 py-3 rounded-tl-lg">Sl</th>
                    <th class="px-3 py-3">Item & Description</th>
                    <th class="px-3 py-3 text-center">HSN</th>
                    <th class="px-3 py-3 text-right">Qty</th>
                    <th class="px-3 py-3 text-right">Rate (<%= currSym %>)</th>
                    <th class="px-3 py-3 text-right">Taxable (<%= currSym %>)</th>
                    <th class="px-3 py-3 text-center">Tax %</th>
                    <th class="px-3 py-3 text-right rounded-tr-lg">Total (<%= currSym %>)</th>
                </tr>
            </thead>
            <tbody>
                <% 
                let computedSub = 0;
                let computedTax = 0;
                doc.items.forEach(function(item, index) { 
                    const q = Number(item.quantity || 0);
                    const r = Number(item.rate || 0);
                    const lineTaxable = q * r;
                    const tRate = Number(item.taxRate != null ? item.taxRate : 18);
                    const lineTax = item.taxAmount != null && Number(item.taxAmount) > 0 ? Number(item.taxAmount) : (lineTaxable * (tRate / 100));
                    const lineTotal = lineTaxable + lineTax;
                    computedSub += lineTaxable;
                    computedTax += lineTax;
                %>
                <tr class="border-b border-slate-200 <%= index % 2 === 0 ? 'bg-white' : 'bg-slate-50' %>">
                    <td class="px-3 py-3 font-medium text-slate-800"><%= index + 1 %></td>
                    <td class="px-3 py-3 font-medium text-slate-800">
                        <%= item.productName %>
                        <% if (item.description) { %>
                            <div class="text-xs text-slate-500 font-normal italic mt-0.5"><%= item.description %></div>
                        <% } %>
                    </td>
                    <td class="px-3 py-3 text-center font-mono text-slate-600"><%= item.hsnCode || item.hsn || '-' %></td>
                    <td class="px-3 py-3 text-right text-slate-600"><%= item.quantity %> <%= item.unit || 'PCS' %></td>
                    <td class="px-3 py-3 text-right text-slate-600"><%= currSym %> <%= r.toFixed(2) %></td>
                    <td class="px-3 py-3 text-right font-medium text-slate-700"><%= currSym %> <%= lineTaxable.toFixed(2) %></td>
                    <td class="px-3 py-3 text-center text-slate-600"><%= tRate %>%</td>
                    <td class="px-3 py-3 text-right font-bold text-slate-900"><%= currSym %> <%= lineTotal.toFixed(2) %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>

        <!-- Totals -->
        <% 
            const finalSub = doc.subtotal != null && Number(doc.subtotal) > 0 ? Number(doc.subtotal) : computedSub;
            const finalTax = doc.taxAmount != null && Number(doc.taxAmount) > 0 ? Number(doc.taxAmount) : computedTax;
            const trans = Number(doc.transportationCharges || 0);
            const pack = Number(doc.packagingCharges || 0);
            const disc = Number(doc.discount || 0);
            const finalGrand = doc.totalAmount != null && Number(doc.totalAmount) > 0 ? Number(doc.totalAmount) : (finalSub + finalTax + trans + pack - disc);
        %>
        <div class="flex justify-end mb-12">
            <div class="w-80">
                <div class="flex justify-between py-1.5 text-sm text-slate-600">
                    <span>Taxable Subtotal:</span>
                    <span class="font-mono"><%= currSym %> <%= finalSub.toFixed(2) %></span>
                </div>
                <div class="flex justify-between py-1.5 text-sm text-slate-600">
                    <span>Total GST Tax:</span>
                    <span class="font-mono"><%= currSym %> <%= finalTax.toFixed(2) %></span>
                </div>
                <% if (trans > 0) { %>
                <div class="flex justify-between py-1.5 text-sm text-slate-600">
                    <span>Freight / Transport (<%= doc.transportationType || 'Freight' %>):</span>
                    <span class="font-mono">+ <%= currSym %> <%= trans.toFixed(2) %></span>
                </div>
                <% } %>
                <% if (pack > 0) { %>
                <div class="flex justify-between py-1.5 text-sm text-slate-600">
                    <span>Packaging (<%= doc.packagingType || 'Packaging' %>):</span>
                    <span class="font-mono">+ <%= currSym %> <%= pack.toFixed(2) %></span>
                </div>
                <% } %>
                <% if (disc > 0) { %>
                <div class="flex justify-between py-1.5 text-sm text-slate-600 border-b border-slate-200">
                    <span>Discount:</span>
                    <span class="font-mono">- <%= currSym %> <%= disc.toFixed(2) %></span>
                </div>
                <% } %>
                <div class="flex justify-between py-3 text-base font-bold text-slate-800 border-t border-slate-200">
                    <span>Grand Total (<%= doc.currency || 'INR' %>):</span>
                    <span class="text-indigo-600 font-mono text-lg"><%= currSym %> <%= finalGrand.toFixed(2) %></span>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="flex justify-between items-end mt-12 pt-8 border-t border-slate-200">
            <div class="w-2/3">
                <% if (doc.otherDetails) { %>
                    <h4 class="text-xs font-bold text-slate-800 mb-1">Terms & Conditions:</h4>
                    <p class="text-xs text-slate-500 max-w-md whitespace-pre-wrap"><%= doc.otherDetails %></p>
                <% } %>
            </div>
            
            <div class="text-right">
                <p class="text-sm font-bold text-slate-800 mb-8">Authorized Signatory</p>
                <p class="text-xs text-slate-500">For <%= companyInfo?.companyName || 'Company' %></p>
            </div>
        </div>
        
        <div class="mt-8 text-center text-[10px] text-slate-400">
            Generated on: <%= new Date().toLocaleString() %>
        </div>
    </div>
</body>
</html>
